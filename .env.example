# ── Database ──────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=face_attendance

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_32_char_string
ACCESS_TOKEN_EXP=15        # phút
REFRESH_TOKEN_EXP=10080    # phút (7 ngày)
OTP_EXP_MINUTES=10
LOGIN_OTP_ENABLED=true     # Đặt false khi test để bỏ OTP đăng nhập

# ── Camera ────────────────────────────────────────────
CAMERA_ID=0                # 0 = webcam mặc định

# ── AI / Face Engine ─────────────────────────────────
FACE_THRESHOLD=0.50        # Ngưỡng nhận diện (0.0 - 1.0)
MIN_FACE_SIZE=40           # px
PRESENTATION_GUARD_ENABLED=true
PRESENTATION_GUARD_ACTION=review
PRESENTATION_GUARD_RISK_THRESHOLD=0.45
PRESENTATION_GUARD_MIN_FRAMES=3
PRESENTATION_GUARD_WINDOW_SECONDS=3.5
EVIDENCE_RETENTION_DAYS=90
AI_AUDIT_MAX_IMAGES_PER_RUN=120
OPENAI_API_KEY=            # Tuỳ chọn: bật AI đề xuất phân ca
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=            # Tuỳ chọn: fallback Google Gemini
GEMINI_MODEL=gemini-3-flash-preview

# ── Chấm công ─────────────────────────────────────────
COOLDOWN_MINUTES=5         # Thời gian chờ giữa 2 lần chấm công
CHECKIN_GRACE_MINUTES=15
OVERTIME_APPROVAL_THRESHOLD_MINUTES=30
CONSECUTIVE_SHIFT_GAP_MINUTES=30
WORK_DAYS=1,2,3,4,5,6,7
NOTIFY_LEAVE_CANCEL=true

# ── Email (Gmail SMTP) ────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=app_password_here   # Bật 2FA → Tạo App Password
EMAIL_TO=admin@company.com         # Fallback khi chi nhánh chưa có email quản lý
DAILY_REPORT_HOUR=18
DAILY_REPORT_MINUTE=0

# ── URLs / CORS ───────────────────────────────────────
BASE_URL=http://127.0.0.1:5600
BACKEND_URL=http://127.0.0.1:8000
WEB_URL=http://127.0.0.1:5600
KIOSK_URL=http://127.0.0.1:5500
# ID chi nhánh/cửa hàng gắn cố định với máy kiosk này. Bắt buộc khi chạy kiosk chấm công.
KIOSK_BRANCH_ID=
CORS_ORIGINS=http://127.0.0.1:5500,http://127.0.0.1:5600,http://localhost:5500,http://localhost:5600
